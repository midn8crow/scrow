#!/usr/bin/env bash
# =============================================================================
# SCROW — Hyprland dotfiles installer & manager
# Usage: scrow [--dry-run] [--dashboard|--install|--refresh|--upgrade|--repair|
#               --reset|--remove NAME|--help]
# =============================================================================

SCROW_ASSUME_YES=0

set -uo pipefail

# --- foundation (paths, palette, version, runners) ----------------------------
SCROW_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$0}")")"
# shellcheck disable=SC1091
source "$SCROW_DIR/core.sh"

SCROW_PACKAGE_DATE="$(date '+%Y%m%d_%H%M%S')"

# --- CLI ---------------------------------------------------------------------
scrow_usage() {
    echo "SCROW $SCROW_VERSION — Hyprland dotfiles installer & manager"
    echo
    echo "Usage: scrow [options] [command]"
    echo
    echo "Options:"
    echo "  --dry-run     show what would happen without changing anything"
    echo "  -y            assume yes for confirmations"
    echo "  -h, --help    show this help"
    echo "  -V, --version show the SCROW version"
    echo
    echo "Commands:"
    echo "  (none)        interactive menu"
    echo "  --dashboard   show component overview"
    echo "  --install     install all missing components"
    echo "  --refresh     re-sync files of installed components"
    echo "  --update      pull the latest repository and converge installed files"
    echo "  --upgrade     system + AUR upgrade, then re-index manifest"
    echo "  --repair      restore user-modified managed files"
    echo "  --restore     restore files from an automatic backup"
    echo "  --reset       remove every SCROW-managed path"
    echo "  --remove NAME remove a single component's files"
}

declare -a SCROW_CLI_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run)      SCROW_DRY_RUN=1 ;;
        -y|--yes)       SCROW_ASSUME_YES=1 ;;
        -h|--help)      scrow_usage; exit 0 ;;
        -V|--version)   echo "SCROW $SCROW_VERSION"; exit 0 ;;
        *)              SCROW_CLI_ARGS+=("$1") ;;
    esac
    shift
done

# --- source modules ------------------------------------------------------------
for _scrow_mod in state config backup sysd package components ownership engine menu; do
    _scrow_file="$SCROW_DIR/$_scrow_mod.sh"
    if [[ -f "$_scrow_file" ]]; then
        # shellcheck disable=SC1090
        source "$_scrow_file"
    else
        echo "SCROW: missing module $_scrow_file" >&2
        exit 1
    fi
done

# --- startup -------------------------------------------------------------------
scrow_log_init "scrow ${SCROW_CLI_ARGS[*]}"
scrow_state_init
scrow_config_load

# The repository is a temporary clone (scrow_repo_acquire); it must never
# outlive this process. Cleanup is idempotent and is also chained onto INT/TERM
# so an interrupted operation cannot leak /tmp/scrow-*.
trap 'scrow_repo_cleanup; exit 130' INT
trap 'scrow_repo_cleanup; exit 143' TERM

# --- dispatch ------------------------------------------------------------------
if [[ ${#SCROW_CLI_ARGS[@]} -gt 0 ]]; then
    _scrow_rc=0
    case "${SCROW_CLI_ARGS[0]}" in
        --dashboard)  scrow_dashboard ;;
        --install)    scrow_engine_install ;;
        --refresh)    scrow_engine_refresh ;;
        --update)     scrow_engine_update ;;
        --upgrade)    scrow_engine_upgrade ;;
        --repair)     scrow_engine_repair ;;
        --restore)    scrow_engine_restore ;;
        --reset)      scrow_engine_reset ;;
        --remove)     scrow_engine_remove_component "${SCROW_CLI_ARGS[1]:-}" ;;
        *)            scrow_usage; exit 1 ;;
    esac
    _scrow_rc=$?
    scrow_repo_cleanup
    exit $_scrow_rc
fi

scrow_menu
scrow_repo_cleanup
