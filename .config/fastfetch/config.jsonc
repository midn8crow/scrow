{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": null,
    "display": {
        "separator": "  ",
        "color": "white",
        "constants": [
            "\u001b[37m",
            "\u001b[34m",
            "\u001b[32m",
            "\u001b[33m"
        ]
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "key": "{$2}            ___________________ _      __"
        },
        {
            "type": "custom",
            "key": "{$2}           / ___/ ___/ ___/ __ \\ | /| / /"
        },
        {
            "type": "custom",
            "key": "{$2}          (__  ) /__/ /  / /_/ / |/ |/ /"
        },
        {
            "type": "custom",
            "key": "{$2}         /____/\\___/_/   \\____/|__/|__/"
        },
        {
            "type": "custom",
            "key": "      {$2}╭───────────────────────────────────╮"
        },
        {
            "type": "kernel",
            "key": "      {$2}│ {$2}{$1}  kernel",
            "format": "{$2}{release>22}{$1}{$2} │"
        },
        {
            "type": "command",
            "key": "      {$2}│   uptime",
            "text": "uptime -p | cut -d ' ' -f 2-",
            "format": "{$2}{>22}{$2} │"
        },
        {
            "type": "shell",
            "key": "      {$2}│ {$2}{$1}  shell ",
            "format": "{$2}{pretty-name>22}{$1}{$2} │"
        },
        {
            "type": "command",
            "key": "      {$2}│ {$3}{$1}  mem   ",
            "text": "free -m | awk 'NR==2{printf \"%.2f GiB / %.2f GiB\",$3/1024,$2/1024}'",
            "format": "{$3}{>22}{$1}{$2} │"
        },
        {
            "type": "packages",
            "key": "      {$2}│   pkgs  ",
            "format": "{$2}{all>22}{$2} │"
        },
        {
            "type": "command",
            "key": "      {$2}│ {$2}{$1}  user  ",
            "text": "echo $USER",
            "format": "{$2}{>22}{$1}{$2} │"
        },
        {
            "type": "command",
            "key": "      {$2}│   hname ",
            "text": "hostnamectl hostname",
            "format": "{$2}{>22}{$2} │"
        },
        {
            "type": "os",
            "key": "      {$2}│ {$4}󰻀{$1}  distro",
            "format": "{$4}{pretty-name>22}{$1}{$2} │"
        },
        {
            "type": "custom",
            "key": "      {$2}╰───────────────────────────────────╯"
        },
        "break",
        "break"
    ]
}
