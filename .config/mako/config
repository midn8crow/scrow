# ==============================================================================
# MAKO NOTIFICATION DAEMON - SCROW STYLE
# ==============================================================================

# --- Colors (auto-generated, do not edit) ---
include=~/.config/mako/mako-colors.ini

# --- Global Geometry & Placement (Dynamic Island) ---
layer=overlay
anchor=top-right
width=360
outer-margin=10,10,0,0
margin=0,0,5,0
padding=8,16
border-size=1
border-radius=25

# --- Typography & Icons ---
font=monospace 11
markup=1
format=<b>%s</b>\n%b
icons=1
max-icon-size=22
icon-border-radius=8
icon-path=/usr/share/icons/Papirus-Dark:/usr/share/icons/Papirus-Light:/usr/share/icons/Papirus:/usr/share/icons/breeze-dark:/usr/share/icons/breeze:/usr/share/icons/Adwaita:/usr/share/icons/AdwaitaLegacy:/usr/share/icons/hicolor

# --- Timeouts & Behavior ---
default-timeout=3000
ignore-timeout=0
max-visible=3
max-history=99
history=1
sort=-time
actions=1
on-button-left=invoke-default-action
on-button-middle=exec makoctl menu -n "$MAKO_NOTIFICATION_ID" -- rofi -dmenu -p Action:
on-button-right=dismiss

# --- Modes ---
[mode=do-not-disturb]
invisible=1
on-notify=none

[mode=silent]
on-notify=none

# --- Urgency Levels ---
[urgency=low]
default-timeout=2000

[urgency=normal]
default-timeout=3000

[urgency=critical]
invisible=0
default-timeout=3500
ignore-timeout=1
background-color=#93000ae6
text-color=#ffdad6
border-color=#ffb4ab

# --- App Overrides ---
[app-name=Spotify]
invisible=1

[app-name="VLC media player"]
default-timeout=1500

[app-name=grimblast]
max-icon-size=30
default-timeout=4000
format=<b>%s</b>\n%b
on-button-left=exec imv "$MAKO_NOTIFICATION_BODY"

# --- OSD Slider (volume / brightness) ---
[app-name=osd]
anchor=top-center
layer=overlay
width=300
outer-margin=0,0,0,0
margin=16,0,0,0
padding=16,12
border-size=1
border-radius=26
icons=1
max-icon-size=30
icon-border-radius=26
text-alignment=center
font=monospace 13
format=%b
default-timeout=1500
# Colors come from mako-colors.ini ([app-name=osd] block, auto-generated)
