#!/usr/bin/env bash
# =============================================================================
# SCROW — setup dispatcher
# =============================================================================
# Entry point: dispatches to actions or shows interactive menu.
#
# Usage:
#   ./setup full            Full installation
#   ./setup components      Component selection
#   ./setup update          Update packages + redeploy
#   ./setup repair          Fix missing/broken files
#   ./setup restore         Restore from backup
#   ./setup doctor          Environment checks
#   ./setup uninstall       Remove SCROW files
#   ./setup                 Interactive menu
#   ./setup help            Show help

set -uo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export REPO_ROOT

# Source all libraries
source "$REPO_ROOT/installer/lib/common.sh"
source "$REPO_ROOT/installer/lib/packages.sh"
source "$REPO_ROOT/installer/lib/deploy.sh"
source "$REPO_ROOT/installer/lib/services.sh"
source "$REPO_ROOT/installer/lib/validate.sh"

# ── Cleanup on exit ───────────────────────────────────────────────────────────
cleanup_on_exit() {
    local rc=$?
    stop_sudo_keepalive
    cleanup_tmpfiles
    if (( rc != 0 )); then
        printf "\n  ${C_DIM}Installation log saved to: %s${C_RST}\n" "$SCROW_LOG_FILE"
    fi
}
trap cleanup_on_exit EXIT

# ── Greeting ──────────────────────────────────────────────────────────────────
show_greeting() {
    printf "\n"
    printf "${C_BOLD}${C_CYN}  ╔══════════════════════════════════════════════════╗${C_RST}\n"
    printf "${C_BOLD}${C_CYN}  ║   ███████╗████████╗██╗   ██╗████████╗██╗  ██╗   ║${C_RST}\n"
    printf "${C_BOLD}${C_CYN}  ║   ██╔════╝╚══██╔══╝██║   ██║╚══██╔══╝██║  ██║   ║${C_RST}\n"
    printf "${C_BOLD}${C_CYN}  ║   ███████╗   ██║   ██║   ██║   ██║   ███████║   ║${C_RST}\n"
    printf "${C_BOLD}${C_CYN}  ║   ╚════██║   ██║   ██║   ██║   ██║   ██╔══██║   ║${C_RST}\n"
    printf "${C_BOLD}${C_CYN}  ║   ███████║   ██║   ╚██████╔╝   ██║   ██║  ██║   ║${C_RST}\n"
    printf "${C_BOLD}${C_CYN}  ║   ╚══════╝   ╚═╝    ╚═════╝    ╚═╝   ╚═╝  ╚═╝   ║${C_RST}\n"
    printf "${C_BOLD}${C_CYN}  ║                                                  ║${C_RST}\n"
    printf "${C_BOLD}${C_CYN}  ║          Arch Linux · Hyprland · v%s${C_RST}            ${C_BOLD}${C_CYN}║${C_RST}\n" "$SCROW_VERSION"
    printf "${C_BOLD}${C_CYN}  ║                                                  ║${C_RST}\n"
    printf "${C_BOLD}${C_CYN}  ╚══════════════════════════════════════════════════╝${C_RST}\n"
    printf "\n"
}

# ── Help ──────────────────────────────────────────────────────────────────────
show_help() {
    printf "Usage: %s [command]\n\n" "$0"
    printf "Commands:\n"
    printf "  full          Full installation (packages + configs + services)\n"
    printf "  components    Select individual components to install\n"
    printf "  update        Update packages and redeploy configuration\n"
    printf "  repair        Fix missing or broken files\n"
    printf "  restore       Restore from backup\n"
    printf "  doctor        Run environment checks\n"
    printf "  uninstall     Remove SCROW-deployed files\n"
    printf "  help          Show this help message\n"
    printf "\n"
    printf "  (no args)     Interactive menu\n"
    printf "\n"
    printf "Quick install:\n"
    printf "  curl -fsSL https://raw.githubusercontent.com/midn8crow/scrow/main/bootstrap.sh | bash\n"
    printf "\n"
}

# ── Interactive menu ──────────────────────────────────────────────────────────
run_menu() {
    show_greeting
    printf "  Distro: %s | Repo: %s\n" "$SCROW_DISTRO_ID" "$REPO_ROOT"
    printf "\n"

    while true; do
        printf "${C_BOLD}  SCROW — %s — Hyprland${C_RST}\n\n" "$SCROW_DISTRO_ID"
        printf "    1) Full Installation\n"
        printf "    2) Components\n"
        printf "    3) Update\n"
        printf "    4) Repair\n"
        printf "    5) Restore Backup\n"
        printf "    6) Doctor\n"
        printf "    7) Uninstall\n"
        printf "    8) Exit\n"
        printf "\n"
        printf "  Choice [1-8]: "
        read -rn1 choice
        printf "\n"

        case "$choice" in
            1) source "$REPO_ROOT/installer/actions/full.sh";      action_full;      return ;;
            2) source "$REPO_ROOT/installer/actions/components.sh"; action_components; return ;;
            3) source "$REPO_ROOT/installer/actions/update.sh";    action_update;    return ;;
            4) source "$REPO_ROOT/installer/actions/repair.sh";    action_repair;    return ;;
            5) source "$REPO_ROOT/installer/actions/restore.sh";   action_restore;   return ;;
            6) source "$REPO_ROOT/installer/actions/doctor.sh";    action_doctor;    return ;;
            7) source "$REPO_ROOT/installer/actions/uninstall.sh"; action_uninstall; return ;;
            8|q|Q) printf "  Goodbye.\n"; return ;;
            *)
                printf "${C_WARN}  Invalid choice.${C_RST}\n\n"
                ;;
        esac
    done
}

# ── Main dispatch ─────────────────────────────────────────────────────────────
case "${1:-}" in
    full|components|update|repair|restore|doctor|uninstall)
        source "$REPO_ROOT/installer/actions/$1.sh"
        "action_$1" "${@:2}"
        ;;
    help|--help|-h)
        show_help
        ;;
    "")
        run_menu
        ;;
    *)
        printf "${C_ERR}Error: Unknown command '%s'${C_RST}\n\n" "$1"
        show_help
        exit 1
        ;;
esac
