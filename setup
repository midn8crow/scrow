#!/usr/bin/env bash
# =============================================================================
# SCROW — setup script
# =============================================================================
# Main entry point for SCROW installation.
#
# Usage:
#   ./setup install          Install SCROW
#   ./setup help             Show help
#   curl -fsSL .../bootstrap.sh | bash   (via bootstrap)
# =============================================================================

set -uo pipefail

# ── Determine repository root ─────────────────────────────────────────────────
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export REPO_ROOT

# ── Source libraries ──────────────────────────────────────────────────────────
# shellcheck source=sdata/lib/environment-variables.sh
source "$REPO_ROOT/sdata/lib/environment-variables.sh"
# shellcheck source=sdata/lib/functions.sh
source "$REPO_ROOT/sdata/lib/functions.sh"
# shellcheck source=sdata/lib/package-installers.sh
source "$REPO_ROOT/sdata/lib/package-installers.sh"
# shellcheck source=sdata/lib/dist-determine.sh
source "$REPO_ROOT/sdata/lib/dist-determine.sh"

# ── Cleanup on exit ───────────────────────────────────────────────────────────
cleanup_on_exit() {
    local rc=$?
    stop_sudo_keepalive
    if (( rc != 0 )); then
        printf "\n  ${C_DIM}Installation log saved to: %s${C_RST}\n" "$SCROW_LOG_FILE"
    fi
}
trap cleanup_on_exit EXIT

# ── Help ──────────────────────────────────────────────────────────────────────
show_help() {
    printf "Usage: %s <subcommand>\n\n" "$0"
    printf "Subcommands:\n"
    printf "  install    Install SCROW (dependencies, setup, and files)\n"
    printf "  help       Show this help message\n"
    printf "\n"
    printf "Quick install (from anywhere):\n"
    printf "  curl -fsSL https://raw.githubusercontent.com/midn8crow/scrow/main/bootstrap.sh | bash\n"
    printf "\n"
}

# ── Install ───────────────────────────────────────────────────────────────────
do_install() {
    prevent_sudo_or_root

    # Source greeting
    source "$REPO_ROOT/sdata/subcmd-install/0.greeting.sh"

    _log "=== SCROW installation started ==="
    _log "REPO_ROOT=$REPO_ROOT"
    _log "DISTRO=$SCROW_DISTRO_ID ($SCROW_DISTRO_FAMILY)"
    _log "VERSION=$SCROW_VERSION"

    # Source install steps (they execute on source)
    source "$REPO_ROOT/sdata/subcmd-install/1.deps-router.sh"
    source "$REPO_ROOT/sdata/subcmd-install/2.setups.sh"
    source "$REPO_ROOT/sdata/subcmd-install/3.files.sh"

    _log "=== SCROW installation completed successfully ==="

    # ── Done ──────────────────────────────────────────────────────────────────
    printf "${C_BOLD}${C_CYN}  ╔══════════════════════════════════════════════════╗${C_RST}\n"
    printf "${C_BOLD}${C_CYN}  ║            Installation complete!               ║${C_RST}\n"
    printf "${C_BOLD}${C_CYN}  ╚══════════════════════════════════════════════════╝${C_RST}\n"
    printf "\n"
    printf "  ${C_BOLD}Next steps:${C_RST}\n"
    printf "  1. Log out and select Hyprland from your display manager\n"
    printf "  2. Or reboot to ensure all services start correctly\n"
    printf "\n"
    printf "  ${C_DIM}Log saved to: %s${C_RST}\n" "$SCROW_LOG_FILE"
    printf "\n"
}

# ── Main dispatch ─────────────────────────────────────────────────────────────
case "${1:-help}" in
    install)
        do_install
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        printf "${C_ERR}Error: Unknown subcommand '%s'${C_RST}\n" "$1"
        printf "\n"
        show_help
        exit 1
        ;;
esac
