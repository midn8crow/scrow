#!/usr/bin/env bash
# SCROW installer dispatcher
# Usage: ./setup install [--noconfirm] [--skip-deps] [--skip-setup] [--skip-files] [--firstrun]

cd "$(dirname "$0")"
REPO_ROOT="$(pwd)"

source ./sdata/lib/env.sh
source ./sdata/lib/functions.sh

prevent_sudo_or_root
set -e

# Options
ask=false
SKIP_DEPS=false
SKIP_SETUP=false
SKIP_FILES=false
SKIP_BACKUP=false

showhelp() {
    cat <<EOF
SCROW - Hyprland dotfiles installer

Usage: $0 <subcommand> [OPTIONS]

Subcommands:
  install        Install/update SCROW dotfiles
  help           Show this help

Options:
  --noconfirm    Non-interactive (default)
  --interactive  Prompt before each step
  --skip-deps    Skip dependency installation
  --skip-setup   Skip system setup
  --skip-files   Skip file deployment
  --skip-aur     Skip AUR package installation
  --skip-backup  Skip backup
  --firstrun     Force firstrun behavior
  -h, --help     Show this help

Examples:
  $0 install                     # Full install (non-interactive)
  $0 install --interactive       # Full install (prompt before each step)
  $0 install --skip-deps         # Skip package installation
  $0 install --skip-aur          # Skip AUR packages (faster, no compilation)

Online install:
  bash <(curl -s https://raw.githubusercontent.com/midn8crow/scrow/main/get)
EOF
    exit 0
}

case "${1:-}" in
    ""|help|--help|-h) showhelp ;;
    install) shift ;;
    *) printf "${RED}Unknown subcommand: $1${RST}\n"; showhelp ;;
esac

# Parse options
while [[ $# -gt 0 ]]; do
    case "$1" in
        --noconfirm)    ask=false; shift ;;
        --interactive)  ask=true; shift ;;
        --skip-deps)    SKIP_DEPS=true; shift ;;
        --skip-setup)   SKIP_SETUP=true; shift ;;
        --skip-files)   SKIP_FILES=true; shift ;;
        --skip-aur)     SKIP_AUR=true; shift ;;
        --skip-backup)  SKIP_BACKUP=true; shift ;;
        --firstrun)     shift ;;
        -h|--help)      showhelp ;;
        *) printf "${RED}Unknown option: $1${RST}\n"; exit 1 ;;
    esac
done

printf "\n${CYAN}${BOLD}=== SCROW Installer ===${RST}\n"
printf "${CYAN}Repository: ${REPO_ROOT}${RST}\n\n"

sudo_init_keepalive
trap sudo_stop_keepalive EXIT INT TERM

# Phase 1: Dependencies
if [[ "$SKIP_DEPS" != true ]]; then
    source "$REPO_ROOT/sdata/subcmd-install/1.deps.sh"
fi

# Phase 2: System setup
if [[ "$SKIP_SETUP" != true ]]; then
    source "$REPO_ROOT/sdata/subcmd-install/2.setups.sh"
fi

# Phase 3: File deployment
if [[ "$SKIP_FILES" != true ]]; then
    source "$REPO_ROOT/sdata/subcmd-install/3.files.sh"
fi

printf "\n${GREEN}${BOLD}=== SCROW Installation Complete ===${RST}\n"
printf "${CYAN}Reboot for all changes to take effect.${RST}\n\n"
