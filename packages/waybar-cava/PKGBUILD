pkgname=waybar-cava
pkgver=0.15.0.r0.g6d60c8e
pkgrel=1
pkgdesc="Highly customizable Wayland bar for Sway/WLroots based compositors, with the cava module built in — pinned Waybar git snapshot (no stock fallback)"
arch=('x86_64')
url='https://github.com/Alexays/Waybar'
license=('MIT')
provides=('waybar')
conflicts=('waybar' 'waybar-cava-git')
depends=(
    'fmt'
    'gtk-layer-shell'
    'gtkmm3'
    'jack2'
    'jsoncpp'
    'libappindicator'
    'libcava'
    'libdbusmenu-gtk3'
    'libevdev'
    'libinput'
    'libmpdclient'
    'libnl'
    'libpulse'
    'libsigc++'
    'sndio'
    'libwireplumber'
    'libxkbcommon'
    'chrono-date'
    'playerctl'
    'spdlog'
    'upower'
    'wayland'
)
makedepends=(
    'cmake'
    'glib2-devel'
    'meson'
    'ninja'
    'python-setuptools'
    'scdoc'
    'wayland-protocols'
)
backup=(
    etc/xdg/waybar/config
    etc/xdg/waybar/style.css
)
optdepends=(
    'otf-font-awesome: Icons in the default configuration'
)
source=("https://github.com/Alexays/Waybar/archive/6d60c8e02be67bb85bb9b1ea803f2fbcf0722002.tar.gz")
sha256sums=('420c0750092f6ab07fe807e298243dc69ab8ea1224e2f2597a82bd65892d8320')

# NOTE: NO --auto-features=enabled here. That flag hard-requires every optional
# module's dependency (gpsd, modemmanager, epoxy, ...) and drifts out of sync
# with upstream - it is what made the fresh VM build abort. Waybar's meson
# options are all 'auto' by default, so a plain setup builds every module whose
# dependency is present and SILENTLY SKIPS the rest. official.txt supplies the
# deps our configs actually use; only cava is forced enabled below.
build() {
    cd "$srcdir/Waybar-6d60c8e02be67bb85bb9b1ea803f2fbcf0722002"
    meson setup --prefix=/usr --buildtype=plain \
        --wrap-mode=nodownload -Dexperimental=true \
        -Dcava=enabled -Dtests=disabled \
        build
    meson compile -C build
}

package() {
    cd "$srcdir/Waybar-6d60c8e02be67bb85bb9b1ea803f2fbcf0722002"
    DESTDIR="$pkgdir" meson install -C build
    install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}

